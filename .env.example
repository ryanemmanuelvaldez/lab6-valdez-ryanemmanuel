# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development
APP_DEBUG=false

# Generate two different random strings of at least 32 characters.
API_JWT_SECRET=
API_REFRESH_TOKEN_KEY=

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# Set these before creating the first admin account. The bootstrap key is only
# accepted while no admin account exists.
ADMIN_BOOTSTRAP_KEY=
